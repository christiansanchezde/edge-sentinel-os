{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Sync Code to Target",
            "type": "shell",
            "command": "rsync -avz --exclude '.git' --exclude 'build' --exclude '.vscode' ./ [YOUR_ORANGE_PI@YOUR_TARGET_IP]:~/edge-sentinel-os/",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "2. Build on Target",
            "type": "shell",
            "command": "ssh [YOUR_ORANGE_PI@YOUR_TARGET_IP] 'cd ~/edge-sentinel-os && mkdir -p build && cd build && cmake .. && make -j4 && ./tests/unit_tests'",
            "dependsOn": "1. Sync Code to Target",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}